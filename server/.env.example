NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://clube:local-development-only@127.0.0.1:5432/clube_do_livro
FRONTEND_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=demo-clube-do-livro
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Produção: remover FIREBASE_AUTH_EMULATOR_HOST, usar projeto exclusivo e ADC.
# Alternativa sem chave privada: mesma chave pública do app web Firebase.
# FIREBASE_WEB_API_KEY=chave-publica-do-app
# Sem FIREBASE_WEB_API_KEY, usar ADC ou GOOGLE_APPLICATION_CREDENTIALS fora do repositório.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/fora/do/repositorio/credencial.json
# Arquivos originais privados (somente servidor; não criar variáveis VITE_):
# MEDIA_BUCKET=clube-livro-media
# AWS_ENDPOINT_URL_S3=https://endpoint-da-branch.storage.neon.tech
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=credencial-restrita
# AWS_SECRET_ACCESS_KEY=segredo-fora-do-git

# Processamento de vídeos: ffmpeg/ffprobe instalados na imagem Docker.
# No desenvolvimento, caminhos locais podem ser definidos explicitamente:
# FFMPEG_PATH=/caminho/ffmpeg
# FFPROBE_PATH=/caminho/ffprobe

# Firebase UIDs allowed to review public reports; empty denies public moderation.
PLATFORM_MODERATOR_UIDS=
